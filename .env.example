# Variáveis próprias do mapa, usadas somente pelas funções serverless.
# Os nomes evitam conflitos com variáveis criadas pela integração da Vercel.
# Nunca use o prefixo VITE_.
ICEWIND_DB_URL=https://seu-projeto.supabase.co
ICEWIND_DB_SECRET_KEY=substitua-pela-chave-privada-do-supabase

# Apenas o trecho depois da barra. Use uma sequência longa e aleatória.
MASTER_SLUG=troque-por-uma-sequencia-longa-e-aleatoria-7f2c91e8

