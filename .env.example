# Variáveis usadas somente pelas funções serverless. Nunca use o prefixo VITE_.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=substitua-pela-service-role-key
# A integração atual da Vercel também pode fornecer SUPABASE_SECRET_KEY.
# Basta configurar uma das duas chaves privadas.
# SUPABASE_SECRET_KEY=sb_secret_substitua

# Apenas o trecho depois da barra. Use uma sequência longa e aleatória.
MASTER_SLUG=troque-por-uma-sequencia-longa-e-aleatoria-7f2c91e8

